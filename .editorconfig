root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,ts,tsx,js,mjs,cjs,yml,yaml,css,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_sort_system_directives_first = true

# CLAUDE.md prescribes plain structured ILogger calls; LoggerMessage source generation is not required.
dotnet_diagnostic.CA1848.severity = none

[tests/**.cs]
# Test names follow the {Behaviour}_{condition}_{expected} convention from CLAUDE.md.
dotnet_diagnostic.CA1707.severity = none
